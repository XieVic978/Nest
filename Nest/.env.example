# Supabase configuration.
# Copy this file to `.env.local` and fill in the values from your Supabase project:
#   Supabase Dashboard -> Project Settings -> API
#
# The EXPO_PUBLIC_ prefix is required so these are available in the app at
# runtime. The publishable key is safe to ship in a client app (it relies on
# row-level security). Never put the service_role/secret key here.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
